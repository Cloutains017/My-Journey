NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=your-admin-password

# Optional independent signing key. Use a random value of at least 32 bytes.
ADMIN_SESSION_SECRET=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Comma-separated origins that may upload directly to R2 via presigned URLs.
# Include each production domain and the local development URL you use.
R2_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://cloutains.top,https://www.cloutains.top
